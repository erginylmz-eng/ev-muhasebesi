# Bu dosyayı ".env" adıyla kopyalayıp gerçek değerlerinizi girin.
# .env dosyası ASLA git'e commit edilmemeli (bkz. .gitignore) — yalnızca
# sunucuda, doğrudan bu dosyayı düzenleyerek doldurun.

# Google Cloud Console > APIs & Services > Credentials'ta oluşturduğunuz
# "OAuth 2.0 Client ID" (Web application) buradaki değerler:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Oturum çerezlerini imzalamak için rastgele, uzun, kimsenin tahmin edemeyeceği
# bir metin (örn. `openssl rand -hex 32` ile üretebilirsiniz):
SESSION_SECRET=

# Sitenin gerçek adresi (sondaki / olmadan) — OAuth yönlendirme adresini
# oluşturmak için kullanılır:
PUBLIC_URL=https://butce.wonsideas.com

# Backend'in dinleyeceği yerel port (nginx bu porta yönlendirir, dışarıya
# doğrudan açılmaz):
PORT=3001

# Verilerin (households, users, invites, sessions, backups) saklanacağı klasör:
DATA_DIR=/opt/ev-muhasebesi/server/data
